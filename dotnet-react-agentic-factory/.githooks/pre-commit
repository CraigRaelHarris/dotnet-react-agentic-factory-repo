#!/bin/sh
if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -File scripts/verify.ps1
elif command -v powershell.exe >/dev/null 2>&1; then
  exec powershell.exe -NoProfile -File scripts/verify.ps1
else
  echo 'PowerShell is required to run the repository verification hook.' >&2
  exit 1
fi
