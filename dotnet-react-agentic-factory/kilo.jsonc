{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "openrouter/z-ai/glm-5.3",
  "instructions": [
    ".kilo/rules/core.md",
    ".kilo/rules/dotnet.md",
    ".kilo/rules/react.md",
    ".kilo/rules/security.md"
  ],
  "compaction": {
    "auto": true,
    "threshold_percent": 60,
    "prune": true,
    "tail_turns": 2
  },
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "ask",
    "bash": "ask",
    "task": "allow",
    "webfetch": "ask",
    "websearch": "ask"
  }
}
